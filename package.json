{
  "name": "moozhak",
  "version": "2.0.0",
  "description": "Vinyl library web app and core SDK for Discogs and BPM workflows",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "sync:domain": "node scripts/sync-domain-client.mjs",
    "restart": "npm run clean:all && npm run sync:domain && npm run css:build && npm run web:dev",
    "web": "npm run sync:domain && node web/server.js",
    "web:dev": "npm run sync:domain && node --watch web/server.js",
    "css:build": "npx tailwindcss -i ./web/src/input.css -o ./web/public/styles.css",
    "css:watch": "npx tailwindcss -i ./web/src/input.css -o ./web/public/styles.css --watch",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch --verbose",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --verbose",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:check": "node scripts/docs-check.mjs",
    "format": "biome format --write .",
    "clean:all": "npm run clean:dist && npm run clean:logs",
    "clean:dist": "rm -rf dist/*",
    "clean:logs": "rm -rf .logs/*",
    "clean:data": "rm -rf data/*",
    "build": "npm run clean:all && npm run sync:domain && npm run lint && npm run test && npm run css:build"
  },
  "keywords": [
    "discogs",
    "music",
    "vinyl",
    "library",
    "bpm"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ansis": "^4.2.0",
    "better-sqlite3": "^11.7.0",
    "disconnect": "^1.2.2",
    "ejs": "^3.1.10",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "daisyui": "^4.12.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.0"
  }
}
