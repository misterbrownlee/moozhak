{
  "name": "moozhak",
  "version": "2.0.0",
  "description": "Vinyl library web app, core SDK, and planned Android client (scanner) for Discogs/BPM workflows",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "sync:domain": "node scripts/sync-domain-client.mjs",
    "web:start": "npm run sync:domain && node web/server.js",
    "web": "npm run web:start",
    "web:dev": "npm run sync:domain && node --watch web/server.js",
    "web:dev:restart": "npm run clean:artifacts && npm run sync:domain && npm run web:css:build && npm run web:dev",
    "restart": "npm run web:dev:restart",
    "web:css:build": "npx tailwindcss -i ./web/src/input.css -o ./web/public/styles.css",
    "web:css:watch": "npx tailwindcss -i ./web/src/input.css -o ./web/public/styles.css --watch",
    "css:build": "npm run web:css:build",
    "css:watch": "npm run web:css:watch",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose",
    "test:web": "NODE_OPTIONS='--experimental-vm-modules' jest tests/web --verbose",
    "test:sdk": "NODE_OPTIONS='--experimental-vm-modules' jest tests/core tests/services tests/config.test.js --verbose",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch --verbose",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --verbose",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:check": "node scripts/docs-check.mjs",
    "format": "biome format --write .",
    "clean": "npm run clean:artifacts",
    "clean:artifacts": "npm run clean:dist && npm run clean:logs",
    "clean:all": "npm run clean:artifacts",
    "clean:dist": "rm -rf dist/*",
    "clean:logs": "rm -rf .logs/*",
    "clean:data": "rm -rf data/*",
    "verify": "npm run sync:domain && npm run lint && npm run test && npm run web:css:build",
    "build": "npm run clean:artifacts && npm run verify",
    "skills:find": "skills find",
    "skills:list": "skills list",
    "skills:add": "skills add",
    "skills:sync": "bash scripts/skills/sync-from-agents.sh",
    "skills:check": "skills check",
    "skills:update": "skills update"
  },
  "keywords": [
    "discogs",
    "music",
    "vinyl",
    "library",
    "bpm"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ansis": "^4.2.0",
    "better-sqlite3": "^11.7.0",
    "disconnect": "^1.2.2",
    "ejs": "^3.1.10",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "skills": "^1.4.5",
    "@biomejs/biome": "^2.3.11",
    "daisyui": "^4.12.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.0"
  },
  "overrides": {
    "minimatch": "3.1.5",
    "filelist": {
      "minimatch": "5.1.9"
    }
  }
}
