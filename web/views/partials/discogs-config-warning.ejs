<% if (typeof showDiscogsWarning !== 'undefined' && showDiscogsWarning) { %>
<div class="alert alert-warning mb-4 shadow-lg">
  <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
  <div>
    <h3 class="font-bold">Discogs setup incomplete</h3>
    <p class="text-sm">
      <% if (typeof discogsTokenSet !== 'undefined' && !discogsTokenSet) { %><span>Personal access token is missing.</span><% } %>
      <% if (typeof discogsUsernameSet !== 'undefined' && !discogsUsernameSet) { %><span><%= typeof discogsTokenSet !== 'undefined' && !discogsTokenSet ? ' ' : '' %>Discogs username is missing.</span><% } %>
      Set both in <a href="/settings" class="link font-semibold">Settings</a> (stored on this server). For JSON API calls you can also send <code class="text-xs">x-moozhak-discogs-token</code> and <code class="text-xs">x-moozhak-discogs-username</code>.
    </p>
  </div>
</div>
<% } %>
