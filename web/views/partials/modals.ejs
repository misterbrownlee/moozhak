<%# All Modal Dialogs %>

<!-- Details Modal (for viewing tracklist before adding) -->
<dialog id="details-modal" class="modal" x-ref="detailsModal">
  <div class="modal-box w-11/12 max-w-3xl">
    <form method="dialog">
      <button class="btn btn-sm btn-ghost absolute right-4 top-4">✕</button>
    </form>
    <template x-if="detailsData">
      <div>
        <div class="flex flex-col md:flex-row gap-6">
          <div class="flex-shrink-0">
            <template x-if="detailsData.cover || detailsData.thumb">
              <img :src="detailsData.cover || detailsData.thumb" :alt="detailsData.title" class="w-48 h-48 object-cover rounded-lg shadow">
            </template>
            <template x-if="!detailsData.cover && !detailsData.thumb">
              <div class="w-48 h-48 bg-base-300 rounded-lg flex items-center justify-center text-4xl">🎵</div>
            </template>
          </div>
          <div class="flex-1">
            <h3 class="text-2xl font-bold">
              <span x-text="detailsData.title"></span>
              <template x-if="detailsData.year">
                <span x-text="' (' + detailsData.year + ')'"></span>
              </template>
            </h3>
            <p class="text-lg text-base-content/70 mt-1" x-text="detailsData.artist"></p>
            <template x-if="detailsData.boxSet">
              <p class="text-sm text-primary mt-1" x-text="'[boxed set - ' + detailsData.boxSet + ']'"></p>
            </template>
          </div>
        </div>
        
        <template x-if="(detailsData.sides && detailsData.sides.length > 0) || (detailsData.tracklist && detailsData.tracklist.length > 0)">
          <div class="mt-6">
            <div class="space-y-4">
              <template x-for="(side, sideIndex) in (detailsData.sides || groupTracksBySide(detailsData.tracklist))" :key="sideIndex">
                <div class="overflow-x-auto">
                  <table class="table table-sm">
                    <thead>
                      <tr>
                        <th class="w-16">#</th>
                        <th>Title</th>
                        <th class="w-16 text-right">BPM</th>
                        <th class="w-16 text-center">Key</th>
                        <th class="w-16 text-center">Sig</th>
                        <th class="w-20 text-right">Duration</th>
                        <th class="whitespace-nowrap" x-show="detailsData.libraryItemId">Set</th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-for="(track, i) in side.tracks" :key="i">
                        <tr class="hover">
                          <td class="w-16 text-base-content/60" x-text="track.position || i + 1"></td>
                          <td x-text="track.title || 'Untitled'"></td>
                          <td class="w-16 text-right text-base-content/60" x-text="track.bpm || '--'"></td>
                          <td class="w-16 text-center text-base-content/60" x-text="track.key || '--'"></td>
                          <td class="w-16 text-center text-base-content/60" x-text="track.timeSignature || '--'"></td>
                          <td class="w-20 text-right text-base-content/60" x-text="track.duration || ''"></td>
                          <td x-show="detailsData.libraryItemId">
                            <button
                              type="button"
                              @click.stop="openTrackSetDialogFromDetails(track)"
                              :class="(isDetailsTrackInSet(track) ? 'btn btn-xs btn-success' : 'btn btn-xs btn-primary') + ' whitespace-nowrap min-w-[6.75rem] inline-flex justify-center'"
                              :title="isDetailsTrackInSet(track) ? 'Manage sets for this track' : 'Add this track to a set'"
                              x-text="isDetailsTrackInSet(track) ? 'In set' : 'Add to set'"
                            ></button>
                          </td>
                        </tr>
                      </template>
                    </tbody>
                  </table>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>
    </template>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<!-- Unified set membership for a library track -->
<dialog id="track-set-dialog" class="modal" x-ref="manageTrackSetModal">
  <div class="modal-box max-w-md max-h-[90vh] overflow-y-auto">
    <button type="button" class="btn btn-sm btn-ghost absolute right-4 top-4" @click="closeTrackSetDialog()" aria-label="Close">✕</button>
    <h3 class="font-bold text-lg pr-10">Set Actions</h3>
    <p class="text-sm text-base-content/60 py-1 line-clamp-2" x-show="trackSetDialogContext && trackSetDialogContext.trackTitle">
      <span class="text-base-content/50">Track: </span><span x-text="trackSetDialogContext.trackTitle"></span>
    </p>
    <div x-show="trackSetDialogLoading" class="py-6 text-center text-base-content/60 text-sm">Loading…</div>
    <div class="space-y-4 mt-2" x-show="!trackSetDialogLoading">
      <div x-show="trackSetDialogMemberSets.length > 0">
        <p class="text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">Already in these sets</p>
        <div class="max-h-48 overflow-y-auto space-y-1 border border-base-200 rounded-lg p-2">
          <template x-for="s in trackSetDialogMemberSets" :key="s.id">
            <div class="flex flex-wrap items-center gap-2 py-2 border-b border-base-200 last:border-0">
              <div class="w-11 h-11 flex-shrink-0 rounded-lg overflow-hidden bg-base-300 ring-1 ring-base-300 aspect-square">
                <div class="grid grid-cols-2 gap-px w-full h-full" x-show="s.thumbUrls && s.thumbUrls.length === 4">
                  <template x-for="(u, ti) in s.thumbUrls" :key="ti">
                    <img :src="u" alt="" class="w-full h-full object-cover min-h-0" loading="lazy" />
                  </template>
                </div>
                <div class="w-full h-full flex items-center justify-center text-lg" x-show="!s.thumbUrls || s.thumbUrls.length !== 4">🎵</div>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-medium text-sm line-clamp-2" x-text="s.name"></p>
              </div>
              <a :href="'/sets/' + s.id" class="link link-primary text-xs flex-shrink-0 whitespace-nowrap">Edit set</a>
              <button type="button" class="btn btn-xs btn-ghost text-warning flex-shrink-0" @click="removeTrackFromMemberSet(s.id)" title="Remove this track from this set">Remove</button>
              <button type="button" class="btn btn-xs btn-outline flex-shrink-0" @click="duplicateTrackInMemberSet(s.id)" title="Add this track again to this set">Duplicate</button>
            </div>
          </template>
        </div>
      </div>
      <div>
        <p class="text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">Add to another set</p>
        <select class="select select-bordered select-sm w-full" x-model="trackSetDialogSelectedSetId">
          <option value="">Choose a set…</option>
          <template x-for="s in trackSetDialogPickerSets()" :key="s.id">
            <option :value="s.id" x-text="s.name || 'Untitled set'"></option>
          </template>
        </select>
        <p class="text-sm text-base-content/50 mt-1" x-show="trackSetDialogPickerSets().length === 0">This track is already in every set.</p>
        <button type="button" class="btn btn-sm btn-primary w-full mt-2" :disabled="!trackSetDialogSelectedSetId || loading" @click="addTrackToSelectedSet()">Add to set</button>
      </div>
      <div>
        <button type="button" class="link link-primary text-sm" @click="createNewSetWithTrack()" :disabled="loading">Add to new set</button>
      </div>
    </div>
    <div class="modal-action">
      <button type="button" class="btn btn-ghost" @click="closeTrackSetDialog()">Close</button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button type="button" @click="closeTrackSetDialog()">close</button>
  </form>
</dialog>

<!-- Delete Confirmation Modal -->
<dialog id="delete-modal" class="modal" x-ref="deleteModal">
  <div class="modal-box">
    <h3 class="font-bold text-lg">Remove Album</h3>
    <template x-if="deleteTarget">
      <div class="py-4">
        <p class="text-base-content/70">Are you sure you want to remove this album from your library?</p>
        <div class="mt-4 p-3 bg-base-200 rounded-lg">
          <p class="font-semibold" x-text="deleteTarget.title"></p>
          <p class="text-sm text-base-content/60" x-text="deleteTarget.artist"></p>
        </div>
        <div class="mt-4 p-3 bg-warning/10 border border-warning/30 rounded-lg" x-show="deleteSetWarnings && deleteSetWarnings.length > 0">
          <p class="font-medium text-warning">This album has tracks in the following sets:</p>
          <ul class="list-disc list-inside mt-2 text-sm">
            <template x-for="s in deleteSetWarnings" :key="s.id">
              <li><a :href="'/sets/' + s.id" class="link link-primary" x-text="s.name"></a></li>
            </template>
          </ul>
          <p class="text-xs text-base-content/60 mt-2">You can still remove the album; set entries will keep snapshot data.</p>
        </div>
      </div>
    </template>
    <div class="modal-action">
      <button @click="cancelDelete()" class="btn btn-ghost">Cancel</button>
      <button @click="confirmDelete()" class="btn btn-warning">Remove</button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button @click="cancelDelete()">close</button>
  </form>
</dialog>
